# Line endings are load-bearing here:
#   * a .cmd with LF confuses cmd.exe
#   * a shell script with CRLF fails inside WSL and Git Bash with a "\r" error
* text=auto

*.sh      text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.json    text eol=lf

*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf
*.psm1    text eol=crlf

# the wrappers have no extension
bin/*     text eol=lf
