# coding-agents-setup-kit — copy to ~/.config/coding-agents-kit/env and chmod 600.
# `./install.sh` does that copy for you and never overwrites the file afterwards.
# Names only: never commit this file with real values, never paste a value into a chat.
#
# Every wrapper loads this file into ITS OWN process. Nothing here is written
# into a CLI's config: Codex gets `env_key`, OpenCode `{env:KEY}`, Pi `"$KEY"`.

# --- Z.AI GLM Coding Plan (claude-glm, codex-glm, opencode-glm, pi-glm) ------
# Key: https://z.ai/manage-apikey/apikey-list
# ZAI_CODING_API_KEY=
# ZAI_DEFAULT_OPUS_MODEL=glm-5.3
# ZAI_DEFAULT_FABLE_MODEL=glm-5.3
# ZAI_DEFAULT_SONNET_MODEL=glm-5.3-flash
# ZAI_DEFAULT_HAIKU_MODEL=glm-5.3-flash
# ZAI_CODING_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ZAI_CODEX_BASE_URL=https://api.z.ai/api/v1
# ZAI_CODEX_DEFAULT_MODEL=
# ZAI_OPENCODE_DEFAULT_MODEL=
# ZAI_PI_DEFAULT_MODEL=
# ZAI_CODING_API_TIMEOUT_MS=3000000
# ZAI_CODING_AUTO_COMPACT_WINDOW=

# --- xAI (codex-xai, opencode-xai, pi-xai, cline-xai; grokx can use OAuth) ---
# Key: https://console.x.ai/
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL_DAILY=grok-code-fast-1
# XAI_MODEL_REASONING=grok-4
# XAI_DEFAULT_MODEL=

# --- Azure OpenAI / Microsoft Foundry (*-azure) -----------------------------
# Set the resource OR the full base URL. Model names are YOUR deployment names.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE=
# AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_MODEL_DAILY=
# AZURE_OPENAI_MODEL_REASONING=
# AZURE_OPENAI_DEFAULT_MODEL=

# --- Optional overrides (defaults shown) ------------------------------------
# AGENTKIT_ENV=~/.config/coding-agents-kit/env          # this file
# AGENTKIT_HOME=~/.local/share/coding-agents-kit        # where wrappers are installed
# AGENTKIT_MACHINES=~/.config/coding-agents-kit/machines.toml   # agentbox config
# OPENCODE_CONFIG=~/.config/opencode/opencode.json      # where opencode-* merge their provider
# PI_MODELS_FILE=~/.pi/agent/models.json                # where pi-* register their provider
# CODEX_HOME=~/.codex                                   # where codex-* write <provider>.config.toml
# CURSORX_SANDBOX=                                      # set to `disabled` to add --sandbox disabled to cursorx
# AGENTBOX_NO_HERDR=                                    # set to 1 to stop agentbox touching Herdr machines
