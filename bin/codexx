#!/usr/bin/env bash
set -euo pipefail
_KIT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck disable=SC1091
source "${_KIT_LIB}/common.sh"
agentkit_require_cmd codex || exit 1
bypass=(--dangerously-bypass-approvals-and-sandbox)
case "${1:-}" in
  -c|--continue|-l|--last) shift; exec codex resume --last "${bypass[@]}" "$@" ;;
  -r|--resume)
    shift
    if [[ -n "${1:-}" && "${1:0:1}" != "-" ]]; then
      id="$1"; shift
      exec codex resume "$id" "${bypass[@]}" "$@"
    fi
    exec codex resume --all "${bypass[@]}" "$@"
    ;;
  *) exec codex "${bypass[@]}" "$@" ;;
esac
