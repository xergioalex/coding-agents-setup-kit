#!/usr/bin/env bash
set -euo pipefail
_KIT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck disable=SC1091
source "${_KIT_LIB}/common.sh"
agentkit_require_cmd pi || exit 1
agentkit_require_zai || exit 1
sonnet="${ZAI_DEFAULT_SONNET_MODEL:-glm-5.3-flash}"
opus="${ZAI_DEFAULT_OPUS_MODEL:-glm-5.3}"
haiku="${ZAI_DEFAULT_HAIKU_MODEL:-glm-5.3-flash}"
default="${ZAI_PI_DEFAULT_MODEL:-${sonnet}}"
# Register the provider in Pi's models.json (apiKey stored as "$ZAI_CODING_API_KEY").
# Same shape as the deepworkplan-website pi-glm: 1M context, no reasoning_effort.
python3 "${_KIT_LIB}/write_pi_provider.py" \
  "${PI_MODELS_FILE:-${HOME}/.pi/agent/models.json}" \
  zai-glm "${ZAI_CODING_BASE_URL:-https://api.z.ai/api/coding/paas/v4}" ZAI_CODING_API_KEY \
  1000000 131072 false "${sonnet}:sonnet" "${opus}:opus" "${haiku}:haiku"
export ZAI_API_KEY="${ZAI_CODING_API_KEY}"
models="zai-glm/${sonnet}"
for id in "${opus}" "${haiku}"; do
  [[ ",${models}," == *",zai-glm/${id},"* ]] || models+=",zai-glm/${id}"
done
exec pi --approve --provider zai-glm --model "${default}" --models "${models}" "$@"
