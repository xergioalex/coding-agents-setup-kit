#!/usr/bin/env bash
set -euo pipefail
_KIT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck disable=SC1091
source "${_KIT_LIB}/common.sh"
agentkit_require_cmd codex || exit 1
agentkit_require_xai || exit 1
config_dir="${CODEX_HOME:-${HOME}/.codex}"
python3 "${_KIT_LIB}/write_codex_profile.py" \
  "${config_dir}/xai.config.toml" xai "xAI Grok" \
  "${XAI_BASE_URL:-https://api.x.ai/v1}" XAI_API_KEY \
  "${XAI_DEFAULT_MODEL:-${XAI_MODEL_DAILY:-grok-code-fast-1}}"
bypass=(--dangerously-bypass-approvals-and-sandbox)
case "${1:-}" in
  -c|--continue|-l|--last) shift; exec codex -p xai resume --last "${bypass[@]}" "$@" ;;
  -r|--resume)
    shift
    if [[ -n "${1:-}" && "${1:0:1}" != "-" ]]; then
      id="$1"; shift
      exec codex -p xai resume "$id" "${bypass[@]}" "$@"
    fi
    exec codex -p xai resume --all "${bypass[@]}" "$@"
    ;;
  *) exec codex -p xai "${bypass[@]}" "$@" ;;
esac
