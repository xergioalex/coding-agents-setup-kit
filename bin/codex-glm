#!/usr/bin/env bash
set -euo pipefail
_KIT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck disable=SC1091
source "${_KIT_LIB}/common.sh"
agentkit_require_cmd codex || exit 1
agentkit_require_zai || exit 1
config_dir="${CODEX_HOME:-${HOME}/.codex}"
python3 "${_KIT_LIB}/write_codex_profile.py" \
  "${config_dir}/glm.config.toml" ZAI "Z.AI GLM Coding Plan" \
  "${ZAI_CODEX_BASE_URL:-https://api.z.ai/api/v1}" ZAI_CODING_API_KEY \
  "${ZAI_CODEX_DEFAULT_MODEL:-${ZAI_DEFAULT_SONNET_MODEL:-glm-5.3-flash}}"
bypass=(--dangerously-bypass-approvals-and-sandbox)
case "${1:-}" in
  -c|--continue|-l|--last) shift; exec codex -p glm resume --last "${bypass[@]}" "$@" ;;
  -r|--resume)
    shift
    if [[ -n "${1:-}" && "${1:0:1}" != "-" ]]; then
      id="$1"; shift
      exec codex -p glm resume "$id" "${bypass[@]}" "$@"
    fi
    exec codex -p glm resume --all "${bypass[@]}" "$@"
    ;;
  *) exec codex -p glm "${bypass[@]}" "$@" ;;
esac
