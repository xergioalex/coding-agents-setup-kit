#!/usr/bin/env bash
set -euo pipefail
_KIT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck disable=SC1091
source "${_KIT_LIB}/common.sh"
agentkit_require_cmd opencode || exit 1
agentkit_require_xai || exit 1
daily="${XAI_MODEL_DAILY:-grok-code-fast-1}"
reasoning="${XAI_MODEL_REASONING:-grok-4}"
default="${XAI_DEFAULT_MODEL:-${daily}}"
# Merges only provider.xai ({env:KEY}); never rewrites the user's global model.
python3 "${_KIT_LIB}/write_opencode_provider.py" \
  "${OPENCODE_CONFIG:-${HOME}/.config/opencode/opencode.json}" \
  xai XAI_API_KEY "${XAI_BASE_URL:-https://api.x.ai/v1}" \
  "${daily}" "${reasoning}"
exec opencode --auto -m "xai/${default}" "$@"
