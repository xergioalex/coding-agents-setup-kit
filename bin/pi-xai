#!/usr/bin/env bash
set -euo pipefail
_KIT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck disable=SC1091
source "${_KIT_LIB}/common.sh"
agentkit_require_cmd pi || exit 1
agentkit_require_xai || exit 1
daily="${XAI_MODEL_DAILY:-grok-code-fast-1}"
reasoning="${XAI_MODEL_REASONING:-grok-4}"
default="${XAI_DEFAULT_MODEL:-${daily}}"
# Register the provider in Pi's models.json (apiKey stored as "$XAI_API_KEY").
python3 "${_KIT_LIB}/write_pi_provider.py" \
  "${PI_MODELS_FILE:-${HOME}/.pi/agent/models.json}" \
  xai-grok "${XAI_BASE_URL:-https://api.x.ai/v1}" XAI_API_KEY \
  200000 32768 true "${daily}:daily" "${reasoning}:reasoning"
exec pi --approve --provider xai-grok --model "${default}" --models "xai-grok/${daily},xai-grok/${reasoning}" "$@"
